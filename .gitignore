# transient render artifacts
4/build/_tmp/
4/build/_check/
__pycache__/

# large regenerable media (rebuild via 4/build/)
*.mp4
*.mp3
*.wav
4/vo/*.mp3
4/vo/*.wav

# secrets — 절대 커밋 금지
.env
client_secret.json
token.json

# signed/temporary upload URLs (expire, contain AWS credential id)
post_payload.json
**/post_payload.json
upload_result.json
**/upload_result.json
media_url.txt
upload_url.txt

# smoke/check artifacts (regenerable)
auto/_smoke_*
auto/jobs/*/_check_*
auto/jobs/*/images/
